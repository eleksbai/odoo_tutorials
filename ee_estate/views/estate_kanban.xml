<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ee_estate.view_properties_kanban_action" model="ir.actions.act_window">
        <field name="name">房地产看板</field>
        <field name="res_model">estate_property</field>
        <field name="view_mode">kanban</field>
    </record>


    <record id="ee_estate.estate_property_kanban" model="ir.ui.view">
        <!--                <field name="name">Property List</field>-->
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <kanban records_draggable="false" default_group_by="property_type_id">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <div>
                                Expected Price:
                                <field name="expected_price" string="Expected Price"/>
                            </div>
                            <div >
                                Best Offer:
                                <field name="best_price" string="Best Offer"/>
                            </div>
                            <div t-if="record.state.raw_value  == 'Sold'">
                                Selling Price:
                                <field name="selling_price" string="Selling Price"/>
                            </div>
                            <field name="tag_ids" string="房产特点" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
