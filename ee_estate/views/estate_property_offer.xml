<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate.view_property_offer_action" model="ir.actions.act_window">
        <field name="name">房产订单</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
        <field name="res_model">estate_property_offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate.estate_offer_list" model="ir.ui.view">
        <!--                <field name="name">Property List</field>-->
        <field name="model">estate_property_offer</field>
        <field name="arch" type="xml">
            <!--<list default_order="price asc">-->
            <list default_order="price desc">
                <field name="buyer_id" string="Buyer"/>
                <field name="price" string="Price"/>
                <field name="property_type_id" optional="hide"/>
                <field name="property_id" optional="hide"/>
                <field name="state" string="State"/>
                <field name="date_deadline"/>
                <!-- 这个只能单次操作，操作完就隐藏-->
                <button name="action_accept" title="accept" type="object" icon="fa-check" invisible="state"/>
                <!--                <button name="action_set_done" string="Mark as Attending" type="object" icon="fa-level-down"-->
                <!--                        invisible="state"/>-->
                <button name="action_refuse" title="reject" type="object" icon="fa-times" invisible="state"/>

            </list>
        </field>
    </record>
</odoo>