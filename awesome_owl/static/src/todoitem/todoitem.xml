<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="awesome_owl.todoitem">
    <div>
      <input class="form-check-input" type="checkbox" t-att-checked="props.isCompleted"/>
        <span t-att-class="{'text-muted':props.isCompleted,'text-decoration-line-through':props.isCompleted}">
        [<t t-esc="props.isCompleted"/>]
            <t t-esc="props.id"/>.
            <t t-esc="props.description"/>
            <t t-esc="props.title"/>
      </span>
    </div>
  </t>
</templates>
